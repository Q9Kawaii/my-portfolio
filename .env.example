# Firebase web config (public; falls back to the values in lib/firebase-config.ts)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated admin emails. Must match the email in firestore.rules.
NEXT_PUBLIC_ADMIN_EMAILS=yashdingar17@gmail.com

# Contact form email via Web3Forms (public access key, used in the browser)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Contact-form backups in Firestore "messages" (server-only).
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Paste the JSON on one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Admin image/CV uploads (Vercel Blob). Created when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=
